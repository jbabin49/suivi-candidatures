# Copier ce fichier en .env et ajuster.
#     cp .env.example .env

# ---- Authentification ----
# "local" : comptes internes (email + mot de passe). Mode par defaut.
# "oidc"  : authentification deleguee a un fournisseur OIDC (SSO).
AUTH_MODE=local

# ---- Pages de documentation generees par FastAPI ----
# L'application n'expose pas d'API : tout est rendu cote serveur, en HTML
# et en formulaires. FastAPI documente malgre tout ses routes sur /docs,
# /redoc et /openapi.json. Desactive par defaut : ces pages sont
# accessibles sans authentification et publient la liste de toutes les
# routes et de tous les champs de formulaire, et elles chargent leurs
# ressources depuis un CDN, ce que la politique de securite du contenu
# bloque. A n'activer qu'en local, pour inspecter les routes.
ENABLE_DOCS=false

# ---- Compte administrateur initial (mode local uniquement) ----
# Cree automatiquement au premier demarrage s'il n'existe aucun compte.
# Laisser vide pour creer le premier compte a la main avec :
#     docker compose exec app python creer_utilisateur.py <email> <nom>
ADMIN_EMAIL=
ADMIN_PASSWORD=

# ---- Cle de signature des sessions ----
# Laisser "change-me" : une cle aleatoire est alors generee et persistee
# dans data/secret.key (incluse dans la sauvegarde du volume). Ne definir
# une valeur ici que si vous voulez fournir votre propre cle.
SECRET_KEY=change-me

# ---- Cookie de session ----
# Ajoute le drapeau Secure au cookie de session : le navigateur ne
# l'envoie alors plus qu'en HTTPS.
#   false : acces en HTTP (localhost, reseau local). Valeur par defaut.
#   true  : application servie en HTTPS derriere un reverse proxy.
# Attention : passer a true sur un acces http:// empeche toute connexion,
# le navigateur ignorant purement et simplement le cookie.
SESSION_COOKIE_SECURE=false

# Duree de vie de la session, en secondes. Defaut 43200 (12 heures).
# La session est un cookie signe, sans etat cote serveur : elle ne peut
# pas etre revoquee a distance. Seule la suppression de data/secret.key
# invalide immediatement toutes les sessions en cours. D'ou une duree
# volontairement courte. Quelques reperes :
#   3600    = 1 heure        43200  = 12 heures (defaut)
#   86400   = 1 jour         604800 = 7 jours
SESSION_MAX_AGE=43200

# ---- Stockage ----
# Dossier des donnees persistantes (base, uploads, cle). Monte en volume.
DATA_DIR=data
# Taille maximale d'un fichier televerse, en octets (defaut 10 Mo).
MAX_UPLOAD_BYTES=10485760
# Extensions autorisees au televersement, separees par des virgules.
# N'ajoutez ni svg ni html : un tel fichier, consulte ensuite,
# s'executerait dans l'origine de l'application.
UPLOAD_EXTENSIONS=pdf,doc,docx,odt,png,jpg,jpeg,webp

# ---- OIDC (uniquement si AUTH_MODE=oidc) ----
OIDC_ISSUER_URL=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
# URL publique du SSO, utilisee par le compose OIDC.
SSO_PUBLIC_URL=
